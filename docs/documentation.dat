cd /home/tleppert<br/>
tar -xvf gatk-4.6.1.0.tar<br/>
rm gatk-4.6.1.0.tar<br/>

#adjust path in the docker<br/>
PATH="/home/user/gatk-4.6.1.0:/usr/lib/jvm/java-17-openjdk-amd64/bin:$PATH"<br/>

#then exit<br/>
exit<br/>

