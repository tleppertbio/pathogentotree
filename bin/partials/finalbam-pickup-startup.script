#!/bin/bash
# See mycosnp-bucket-clean.py for documentation
SAMPLE=SRRtempnumber
BUCKET_NAME=test-data-bucket
GOOGLE_REGION=us-west1
PROJECT_ID=c-auris-cdc
PATHOGEN_IMAGE=pathogentotree
mkdir -p /home/usera/the_data
mkdir -p /home/usera/the_data/reference
mkdir -p /home/usera/the_data/reference/bwa
chown usera:usera /home/usera/the_data
chown usera:usera /home/usera/the_data/reference
chown usera:usera /home/usera/the_data/reference/bwa
# Run the docker image for google/cloud-sdk
docker run -d --mount type=bind,src=/home/usera/the_data,dst=/the_data google/cloud-sdk:slim sleep infinity
echo 'Waiting for google/cloud-sdk:slim...'
GSDK_TIMEOUT=300
GSDK_ELAPSED=0
GOOGLEDOCKER=google/cloud-sdk:slim
while [ $GSDK_ELAPSED -lt $GSDK_TIMEOUT ]; do
    GCONTAINER_ID=$(docker ps -q --filter ancestor=$GOOGLEDOCKER | head -n 1)
    [ -n "$GCONTAINER_ID" ] && break
    sleep 10; GSDK_ELAPSED=$((GSDK_ELAPSED+10))
done
if [ -z "$GCONTAINER_ID" ]; then echo 'ERROR: google/cloud-sdk:slim did not start in time' && exit 1; fi 
touch /home/usera/google.runs
echo "$GCONTAINER_ID" > /home/usera/google-cloud-sdk.id
GOOGLEIMAGE=$GCONTAINER_ID
GOOGLEDOCKER=google/cloud-sdk:slim
# Check if the google/cloud-sdk is running
GCONTAINER_ID=$(docker ps --all --filter ancestor=$GOOGLEDOCKER --format="{{.ID}}" | head -n 1)
GCONTAINER_STATUS=$(docker inspect --format "{{json .State.Status }}" $GCONTAINER_ID)
running_str="running"
if [[ $GCONTAINER_STATUS == *$running_str* ]]; then
	touch /home/usera/google.runs
fi
# Check if the pathogentotree is running
docker run -d --mount type=bind,src=/home/usera/the_data,dst=/the_data $PATHOGEN_IMAGE sleep infinity
echo 'Waiting for pathogentotree...'
PTREE_TIMEOUT=900
PTREE_ELAPSED=0
PATHOGENDOCKER=$PATHOGEN_IMAGE
while [ $PTREE_ELAPSED -lt $PTREE_TIMEOUT ]; do
    CCONTAINER_ID=$(docker ps -q --filter ancestor=$PATHOGENDOCKER | head -n 1)
    [ -n "$CCONTAINER_ID" ] && break
    sleep 10; PTREE_ELAPSED=$((PTREE_ELAPSED+10))
done
if [ -z "$CCONTAINER_ID" ]; then echo 'ERROR: pathogentotree did not start in time' && exit 1; fi
touch /home/usera/docker.runs
echo "$CCONTAINER_ID" > /home/usera/pathogentotree.id
PATHOGENIMAGE=$CCONTAINER_ID
CCONTAINER_STATUS="running"
docker exec $GOOGLEIMAGE gsutil cp gs://${BUCKET_NAME}/${SAMPLE}.bam /the_data/${SAMPLE}.bam
docker exec $GOOGLEIMAGE gsutil cp gs://${BUCKET_NAME}/${SAMPLE}.bai /the_data/${SAMPLE}.bai
chown usera:usera /home/usera/the_data
chown usera:usera /home/usera/*
chown usera:usera /home/usera/*.id
chown usera:usera /home/usera/*.pathogen
if [[ $CCONTAINER_STATUS == *$running_str* ]] && [[ $GCONTAINER_STATUS == *$running_str* ]]; then
        # housekeeping
        docker exec -w /the_data $PATHOGENIMAGE fix-id.sh
        docker exec -w /the_data/reference $PATHOGENIMAGE fix-id.sh
        docker exec -w /the_data/reference/bwa $PATHOGENIMAGE fix-id.sh
        docker exec $PATHOGENIMAGE ln -s /usr/bin/python3 /usr/bin/python
        # pull reference files
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.cluster /the_data/reference
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.coords /the_data/reference
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.delta /the_data/reference
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.dict /the_data/reference
	docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.fa /the_data/reference
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.fasta.fai /the_data/reference
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.fasta /the_data/reference
	docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.amb /the_data/reference/bwa
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.ann /the_data/reference/bwa
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.bwt /the_data/reference/bwa
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.pac /the_data/reference/bwa
        docker exec $GOOGLEIMAGE gsutil cp gs://$BUCKET_NAME/reference.sa /the_data/reference/bwa
        docker exec -w /the_data/reference $PATHOGENIMAGE fix-id.sh
        docker exec -w /the_data/reference/bwa $PATHOGENIMAGE fix-id.sh
fi # if $CCONTAINER_STATUS && $GCONTAINER_STATUS both == *$running_str*
# if AddOrReplaceReadGroups ran
if [ -f /home/usera/the_data/$SAMPLE.bam ]; then
    touch /home/usera/running.gatk
    docker exec -w /the_data $PATHOGENIMAGE /home/user/gatk-4.6.1.0/gatk --java-options "-Xms6G -Xmx6G" HaplotypeCaller -R reference/reference.fasta -I $SAMPLE.bam -O $SAMPLE.g.vcf.gz -ERC GVCF --sample-ploidy "1"
    # cleanup AddOrReplaceReadGroups
    docker exec -w /the_data $PATHOGENIMAGE fix-id.sh
    # if gatk ran
    if [ -f /home/usera/the_data/$SAMPLE.g.vcf.gz ]; then
	touch /home/usera/running.vcf_to_maple
	docker exec -w /the_data $PATHOGENIMAGE /usr/bin/python3 /bin/gvcf_to_maple_haploid.py -i /the_data/$SAMPLE.g.vcf.gz -DP 20 -GQ 99 -o AND
	# cleanup from gatk
#	docker exec -w /the_data $PATHOGENIMAGE rm $SAMPLE.bam
#	docker exec -w /the_data $PATHOGENIMAGE rm $SAMPLE.bai
	docker exec -w /the_data $PATHOGENIMAGE rm $SAMPLE.g.vcf.gz.tbi
	docker exec -w /the_data $PATHOGENIMAGE fix-id.sh
	# if vcf_to_maple ran
	if [ -f /home/usera/the_data/$SAMPLE.maple ]; then
	    # move files back to data-bucket
	    touch /home/usera/the_data/$SAMPLE.done
	    docker exec $GOOGLEIMAGE gsutil cp /the_data/$SAMPLE.maple gs://$BUCKET_NAME/$SAMPLE.maple
	    docker exec $GOOGLEIMAGE gsutil cp /the_data/$SAMPLE.g.vcf.gz gs://$BUCKET_NAME/$SAMPLE.g.vcf.gz
	    docker exec $GOOGLEIMAGE gsutil cp /the_data/$SAMPLE.done gs://$BUCKET_NAME/$SAMPLE.done
	fi # if [ -f $SAMPLE.maple ]; then
    fi # if [ -f $SAMPLE.g.vcf.gz ]; then
fi # if [ -f $SAMPLE.bam ]; then
docker exec -w /the_data $PATHOGENIMAGE fix-id.sh
touch /home/usera/the_data/$SAMPLE.finished
docker exec $GOOGLEIMAGE gsutil cp /the_data/$SAMPLE.finished gs://$BUCKET_NAME/$SAMPLE.finished
# gcloud compute instances stop vm
sudo shutdown now
