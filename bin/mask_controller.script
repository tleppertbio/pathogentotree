#!/bin/bash
#
# mask_controller.script is called from master_vm.script
# ./split_chrom is created by
# ../mask_files should be downloaded from the pathogentotree github.
# You may wish to change the .bed files in the ../mask_files directory.
#
# This scripts determines that the folders exist and thet there are bed files to use.
# This script runs ../bin/mask_maples.py for each chromosome which masks the files in the list split_nhin.list
# split_nhin.list for each chromosome is the list of files in ./split_chrom/*.N.maple for each chromosome N
# Each file in split_nhin.list is masked using the .bed files in ../mask_files and deposits the masked
# files in $mask_chrom_dir
#
WORKING_DIR=""
BIN_DIR=""
usage() {
    echo "Usage: $0 [-v|--verbose] [-w|--working working_dir] [-b|--bin bin_folder]"
    exit 1
}
# Loop through all arguments until none are left
while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            shift # Move past the flag
            ;;
	-w|--working)
	    if [[ -z "$2" || "$2" =~ ^- ]]; then
                echo "Error: --working requires an string argument."
                exit 1
            else
                WORKING_DIR="$2"
                shift 2 # Move past the flag and its value
            fi
            ;;
	-b|--bin)
            if [[ -z "$2" || "$2" =~ ^- ]]; then
                echo "Error: --bin requires an string argument."
                exit 1
            else
                BIN_DIR="$2"
                shift 2 # Move past the flag and its value
            fi
            ;;
	-h|--help)
            usage
            ;;
        *) # Handle unknown options or positional parameters
            echo "Unknown option: $1"
            usage
            ;;
    esac
done
split_chrom_dir=${WORKING_DIR}/split_chrom
mask_files_dir=${WORKING_DIR}/../mask_files
if [[ ! -d $split_chrom_dir ]]; then
    echo "missing $split_chrom_dir folder, please check master_vm.script at split maples by chromosomes."
    exit 1
fi
if [[ ! -d $mask_files_dir ]]; then
    echo "missing $mask_files_dir folder, please create a mask_files_dir with fasTAN_x.bed files."
    echo "Or skip this step and comment out in master_vm.script."
fi
if [[ -d $mask_files_dir ]]; then
    mask_bed_files=$mask_files_dir/*.bed
    if [[ ! -e "${mask_files_dir[0]}" ]]; then
	echo "missing $mask_fiels_dir/*.bed files, please create a mask_files_dir with fasTAN_x.bed files."
	exit 1	
    fi
fi
if [[ -d $split_chrom_dir && -d $mask_files_dir ]]; then
    mask_chrom_dir=$WORKING_DIR/mask_chrom
    if [[ ! -d $mask_chrom_dir ]]; then
	mkdir -p $mask_chrom_dir
    fi
    ls $WORKING_DIR/split_chrom/*.1.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_1.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.2.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_2.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.3.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_3.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.4.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_4.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.5.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_5.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.6.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_6.bed -d $mask_chrom_dir
    ls $WORKING_DIR/split_chrom/*.7.maple > split_nhin.list
    python3 $BIN_DIR/mask_maple.py -l split_nhin.list -m $mask_files_dir/fasTAN_7.bed -d $mask_chrom_dir
    rm split_nhin.list
fi
gzip $WORKING_DIR/split_chrom/*.1.maple
gzip $WORKING_DIR/split_chrom/*.2.maple
gzip $WORKING_DIR/split_chrom/*.3.maple
gzip $WORKING_DIR/split_chrom/*.4.maple
gzip $WORKING_DIR/split_chrom/*.5.maple
gzip $WORKING_DIR/split_chrom/*.6.maple
gzip $WORKING_DIR/split_chrom/*.7.maple
