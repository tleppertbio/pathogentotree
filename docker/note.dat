gsutil cp gs://test-154312-data-bucket/reference.coords /the_data/reference

fix-id.sh
#
##############################################################
#
seqkit pair -1 $SAMPLE"_1.fastq" -2 $SAMPLE"_2.fastq" --threads 2
# creates SRR*_1.paired.fastq SRR*_2.paired.fastq
#
fix-id.sh
##############################################################
#
FaQCs -d . -1 $SAMPLE"_1.paired.fastq" -2 $SAMPLE"_2.paired.fastq" --prefix $SAMPLE -t 2 --debug 2> $SAMPLE".fastp.log"
#
# creates qa.SRR*.base_content.txt, qa.SRR*.base.matrix, qa.SRR*.for_qual_histogram.txt, qa.SRR*.length_count.txt
# creates qa.SRR*.quality.matrix, SRR*_1.trimmed.fastq, SRR*_2.trimmed.fastq
# creates SRR*.base_content.txt, SRR*.base.matrix, SRR*.fastp.log, SRR*.for_qual_histogram.txt,
# creates SRR*.length_count.txt, SRR*.quality.matrix, SRR*.stats.txt, SRR*.unpaired.trimmed.fastq
rm *.txt
rm *.matrix
rm *.log
rm *.unpaired.trimmed.fastq
#
fix-id.sh
##############################################################
#
bwa mem -t 2 reference/bwa/reference $SAMPLE".1.trimmed.fastq" $SAMPLE".2.trimmed.fastq" | samtools sort --threads 2 -o $SAMPLE".bam"
# creates SRR*.bam
#
fix-id.sh
##############################################################
#
java -jar /bin/picard.jar MarkDuplicates REMOVE_DUPLICATES=true ASSUME_SORT_ORDER=coordinate VALIDATION_STRINGENCY=LENIENT I=$SAMPLE".bam" O=$SAMPLE"_markdups.bam" M=$SAMPLE"_markdups.MarkDuplicates.metrics.txt"
# creates SRR*_markdups.bam SRR*_markdups.MarkDuplicates.metrics.txt
rm *.txt
#
fix-id.sh
##############################################################
#
java -jar /bin/picard.jar CleanSam -I $SAMPLE"_markdups.bam" -O $SAMPLE"_clean.bam"
# creates SRR*_clean.bam
#
fix-id.sh
##############################################################
#
java -jar /bin/picard.jar FixMateInformation -I $SAMPLE"_clean.bam" -O $SAMPLE"_fixmate.bam" --VALIDATION_STRINGENCY LENIENT
# creates SRR*_fixmate.bam
#
fix-id.sh
##############################################################
#
mkdir replace
fix-id.sh
cd replace
java -jar /bin/picard.jar AddOrReplaceReadGroups --INPUT ../$SAMPLE"_fixmate.bam" --OUTPUT $SAMPLE".bam" -ID id -LB library -PL illumina -PU barcode -SM $SAMPLE -CREATE_INDEX true
# creates SRR*.bam, SRR*.bai
#
fix-id.sh
##############################################################
#
gatk --java-options "-Xms6G -Xmx6G" HaplotypeCaller -R reference/reference.fasta -I $SAMPLE".bam" -O $SAMPLE".g.vcf.gz" -ERC GVCF --sample-ploidy "1"
# creates SRR*.g.vcf.gz SRR*.g.vcf.gz.tbi
#
fix-id.sh
##############################################################
#
/bin/python3 ~/bin/gvcf_to_maple_haploid.py $SAMPLE".g.vcf.gz" > $SAMPLE".maple"
# creates SRR*.maple
#
fix-id.sh
##############################################################
##############################################################

